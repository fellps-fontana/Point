# Copie este arquivo para .env e ajuste antes do primeiro "docker compose up"
# Porta exposta no host (mude se conflitar com o myfinance)
HOST_PORT=4001

# Segredo usado para assinar o token de login. Troque por qualquer string aleatoria.
JWT_SECRET=troque_este_segredo

# Usuario admin criado automaticamente na primeira execucao (so na primeira vez, se nao houver usuarios)
ADMIN_USER=admin
ADMIN_PASS=admin123
